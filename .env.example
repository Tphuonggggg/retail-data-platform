# Chỉ ghi tên biến và giá trị không nhạy cảm; không commit .env thực.
WWI_SQLSERVER_HOST=
WWI_SQLSERVER_DATABASE=WideWorldImporters
WWI_SQLSERVER_AUTH_MODE=
# Production defaults. Development-only options require APP_ENV=development.
APP_ENV=production
WWI_ALLOW_ADMIN_SOURCE=no
WWI_SQLSERVER_ENCRYPT=yes
WWI_SQLSERVER_TRUST_SERVER_CERTIFICATE=no
WWI_BATCH_SIZE=500
WWI_LOGIN_TIMEOUT=5
WWI_QUERY_TIMEOUT=60
WAREHOUSE_DATABASE_URL=
BIGQUERY_PROJECT_ID=

# Isolated PostgreSQL Raw. Copy to ignored .env; supply two DIFFERENT secrets.
# Simple random secrets (16+ characters, no $, # or backslash) work with both parsers.
RAW_PG_HOST=127.0.0.1
RAW_PG_PORT=55434
RAW_PG_DATABASE=retail_raw
RAW_PG_USER=retail_ingest
RAW_PG_PASSWORD=
RAW_PG_ADMIN_PASSWORD=
# Justified local-only setting: Docker is published to IPv4 loopback, not a network.
# Source TLS Encrypt=yes; explicit development trust=yes is supported.
RAW_PG_SSLMODE=disable
