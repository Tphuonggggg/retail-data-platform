      {
        "name": "Metrics",
        "lineageTag": "d8411c02-a906-5db2-a7eb-1d9dbd077ba4",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Placeholder",
            "dataType": "string",
            "sourceColumn": "[Placeholder]",
            "lineageTag": "d0385981-4fef-5aa3-a7a3-251d13df4ded",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Placeholder\",BLANK())"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales Before Tax",
            "expression": "CALCULATE(SUM('Invoice Lines'[invoiced_sales_before_tax]),'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0.00",
            "displayFolder": "Sales",
            "description": "S05: invoiced sales before tax, InvoiceDate; not recognized revenue. Eligible WARNING rows retained.",
            "lineageTag": "17cbbffc-9008-55e8-9479-432ea90e10a0"
          },
          {
            "name": "Total Tax",
            "expression": "CALCULATE(SUM('Invoice Lines'[tax_amount]),'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0.00",
            "displayFolder": "Sales",
            "description": "Total Tax",
            "lineageTag": "d0f76448-f93f-5166-9577-dc2fa9fea86d"
          },
          {
            "name": "Total Amount Including Tax",
            "expression": "CALCULATE(SUM('Invoice Lines'[invoice_amount_including_tax]),'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0.00",
            "displayFolder": "Sales",
            "description": "Total Amount Including Tax",
            "lineageTag": "7baef8f5-6111-5c5b-a7f7-d922b2823be5"
          },
          {
            "name": "Units Sold",
            "expression": "CALCULATE(SUM('Invoice Lines'[quantity]),'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "Units Sold",
            "lineageTag": "63269e84-0300-5a7c-81b4-ca239469aa8e"
          },
          {
            "name": "Eligible Invoice Lines",
            "expression": "CALCULATE(COUNTROWS('Invoice Lines'),'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "Eligible Invoice Lines",
            "lineageTag": "bf05a48d-6da9-5668-b14b-04486cfdf228"
          },
          {
            "name": "Invoice Count",
            "expression": "VAR BaseCount=CALCULATE(COUNTROWS(Invoices),Invoices[is_sales_eligible]=TRUE())\nRETURN IF(ISCROSSFILTERED(Product),\n CALCULATE(COUNTROWS(Invoices),Invoices[is_sales_eligible]=TRUE(),\n TREATAS(CALCULATETABLE(VALUES('Invoice Lines'[source_invoice_id]),'Invoice Lines'[is_sales_eligible]=TRUE()),Invoices[source_invoice_id])),BaseCount)",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "S02: eligible invoice-header population. Product filtering uses invoice ID semijoin, never summed product distinct counts.",
            "lineageTag": "ab1a1f16-5c6a-52de-859f-1188adb6ce9b"
          },
          {
            "name": "Order Count",
            "expression": "CALCULATE(COUNTROWS(Orders),Orders[is_order_eligible]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "S01: Orders/OrderDate, including uninvoiced orders; intentionally not product-filtered.",
            "lineageTag": "e3399432-67e0-5688-981e-6f1b087854f9"
          },
          {
            "name": "Average Invoice Value",
            "expression": "DIVIDE([Total Sales Before Tax],[Invoice Count])",
            "formatString": "#,0.00",
            "displayFolder": "Sales",
            "description": "S06: recomputed ratio of totals in the same context; not AOV.",
            "lineageTag": "d552b7c9-38b4-517b-9c06-2f8545a124b0"
          },
          {
            "name": "Sales per Unit",
            "expression": "DIVIDE([Total Sales Before Tax],[Units Sold])",
            "formatString": "#,0.00",
            "displayFolder": "Sales",
            "description": "Source quantity basis; not standardized packaging or piece price.",
            "lineageTag": "ec35b7f3-d48b-5d1b-88e9-3023d1dce2aa"
          },
          {
            "name": "Sales Previous Year Comparable Period",
            "expression": "VAR PreviousDates=SELECTCOLUMNS(VALUES('Date'[calendar_date]),\"PriorDate\",EDATE('Date'[calendar_date],-12))\nRETURN IF(HASONEVALUE('Date'[calendar_year]),CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),TREATAS(PreviousDates,'Date'[calendar_date])))",
            "formatString": "#,0.00",
            "displayFolder": "Time intelligence",
            "description": "Only one selected calendar year. Same selected dates shifted 12 months; leap day maps to prior Feb 28. Other filters retained.",
            "lineageTag": "28464049-d152-5097-aa0e-177ec617e76c"
          },
          {
            "name": "Sales YoY %",
            "expression": "DIVIDE([Total Sales Before Tax]-[Sales Previous Year Comparable Period],[Sales Previous Year Comparable Period])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Time intelligence",
            "description": "Sales YoY %",
            "lineageTag": "b11e9f70-13e6-5285-ac60-943f05a8cae9"
          },
          {
            "name": "Invoice Count Previous Year Comparable Period",
            "expression": "VAR PreviousDates=SELECTCOLUMNS(VALUES('Date'[calendar_date]),\"PriorDate\",EDATE('Date'[calendar_date],-12))\nRETURN IF(HASONEVALUE('Date'[calendar_year]),CALCULATE([Invoice Count],REMOVEFILTERS('Date'),TREATAS(PreviousDates,'Date'[calendar_date])))",
            "formatString": "#,0.00",
            "displayFolder": "Time intelligence",
            "description": "Only one selected calendar year. Same selected dates shifted 12 months; leap day maps to prior Feb 28. Other filters retained.",
            "lineageTag": "03747330-8800-5951-8266-9d408b1a5bab"
          },
          {
            "name": "Invoice Count YoY %",
            "expression": "DIVIDE([Invoice Count]-[Invoice Count Previous Year Comparable Period],[Invoice Count Previous Year Comparable Period])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Time intelligence",
            "description": "Invoice Count YoY %",
            "lineageTag": "f3fad123-e497-50d8-9617-198795f2ae1b"
          },
          {
            "name": "AIV Previous Year Comparable Period",
            "expression": "VAR PreviousDates=SELECTCOLUMNS(VALUES('Date'[calendar_date]),\"PriorDate\",EDATE('Date'[calendar_date],-12))\nRETURN IF(HASONEVALUE('Date'[calendar_year]),CALCULATE([Average Invoice Value],REMOVEFILTERS('Date'),TREATAS(PreviousDates,'Date'[calendar_date])))",
            "formatString": "#,0.00",
            "displayFolder": "Time intelligence",
            "description": "Only one selected calendar year. Same selected dates shifted 12 months; leap day maps to prior Feb 28. Other filters retained.",
            "lineageTag": "ded4ad27-9683-5956-b161-6d83616a95d5"
          },
          {
            "name": "AIV YoY %",
            "expression": "DIVIDE([Average Invoice Value]-[AIV Previous Year Comparable Period],[AIV Previous Year Comparable Period])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Time intelligence",
            "description": "AIV YoY %",
            "lineageTag": "db70b13c-4461-56e5-8903-cd089880550b"
          },
          {
            "name": "Sales Previous Period",
            "expression": "IF(HASONEVALUE('Date'[Year Month]),CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),DATEADD('Date'[calendar_date],-1,MONTH)))",
            "formatString": "#,0.00",
            "displayFolder": "Time intelligence",
            "description": "Previous month only in a single year-month context; BLANK at multi-month totals.",
            "lineageTag": "3906ecf6-59f2-577e-93a3-3b16b19c73d4"
          },
          {
            "name": "Sales MoM %",
            "expression": "DIVIDE([Total Sales Before Tax]-[Sales Previous Period],[Sales Previous Period])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Time intelligence",
            "description": "Sales MoM %",
            "lineageTag": "79e74f5c-cb9d-5f9f-83e3-4c3f6222c23f"
          },
          {
            "name": "Sales YTD",
            "expression": "VAR Cutoff=MAX('Date'[calendar_date]) RETURN CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[calendar_date],DATE(YEAR(Cutoff),1,1),Cutoff))",
            "formatString": "#,0.00",
            "displayFolder": "Time intelligence",
            "description": "Sales YTD",
            "lineageTag": "9d4ee505-eb15-5f27-b5e2-fea786ddf4e7"
          },
          {
            "name": "Prior Year Comparable YTD",
            "expression": "VAR Cutoff=MAX('Date'[calendar_date]) VAR Prior=EDATE(Cutoff,-12) RETURN CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[calendar_date],DATE(YEAR(Prior),1,1),Prior))",
            "formatString": "#,0.00",
            "displayFolder": "Time intelligence",
            "description": "Prior Year Comparable YTD",
            "lineageTag": "f0d18c5d-67c7-5ad8-bc01-3cd3db7e74f4"
          },
          {
            "name": "YTD YoY %",
            "expression": "DIVIDE([Sales YTD]-[Prior Year Comparable YTD],[Prior Year Comparable YTD])",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Time intelligence",
            "description": "YTD YoY %",
            "lineageTag": "6d2c523d-d495-5e31-83a2-fce7abb65816"
          },
          {
            "name": "Volume Contribution",
            "expression": "IF(NOT ISBLANK([Invoice Count Previous Year Comparable Period]),([Invoice Count]-[Invoice Count Previous Year Comparable Period])*[AIV Previous Year Comparable Period])",
            "formatString": "#,0.00",
            "displayFolder": "Decomposition",
            "description": "Volume Contribution",
            "lineageTag": "d22d3868-7b38-5404-b885-cc74b807d5e6"
          },
          {
            "name": "AIV Contribution",
            "expression": "IF(NOT ISBLANK([Invoice Count Previous Year Comparable Period]),([Average Invoice Value]-[AIV Previous Year Comparable Period])*[Invoice Count Previous Year Comparable Period])",
            "formatString": "#,0.00",
            "displayFolder": "Decomposition",
            "description": "AIV Contribution",
            "lineageTag": "856d39eb-58eb-5efc-9627-21b0e27ac983"
          },
          {
            "name": "Interaction Contribution",
            "expression": "IF(NOT ISBLANK([Invoice Count Previous Year Comparable Period]),([Invoice Count]-[Invoice Count Previous Year Comparable Period])*([Average Invoice Value]-[AIV Previous Year Comparable Period]))",
            "formatString": "#,0.00",
            "displayFolder": "Decomposition",
            "description": "Interaction Contribution",
            "lineageTag": "2b0ce2fb-951b-5f20-a916-dec2ac24dac9"
          },
          {
            "name": "Sales Change Contribution",
            "expression": "SWITCH(SELECTEDVALUE(Decomposition[Component]),\"Invoice volume\",[Volume Contribution],\"AIV\",[AIV Contribution],\"Interaction\",[Interaction Contribution])",
            "formatString": "#,0.00",
            "displayFolder": "Decomposition",
            "description": "Exact three-term delta: deltaN*A0 + N0*deltaA + deltaN*deltaA. Arithmetic, not causality.",
            "lineageTag": "c09a738b-8637-5907-85bd-17ce7a41e3cf"
          },
          {
            "name": "Performance Narrative",
            "expression": "IF(ISBLANK([Sales YoY %]),\"Select one calendar year. 2016 covers January–May only.\",\"Sales \"&FORMAT([Sales YoY %],\"+0.00%;-0.00%\")&\" | invoices \"&FORMAT([Invoice Count YoY %],\"+0.00%;-0.00%\")&\" | AIV \"&FORMAT([AIV YoY %],\"+0.00%;-0.00%\")&\" versus equivalent prior-year dates.\")",
            "formatString": "",
            "displayFolder": "Narratives",
            "description": "Performance Narrative",
            "lineageTag": "0dacccf1-ec86-5a45-9499-90ba6cc01aec"
          },
          {
            "name": "Product Sales",
            "expression": "[Total Sales Before Tax]",
            "formatString": "#,0.00",
            "displayFolder": "Products",
            "description": "Product Sales",
            "lineageTag": "623b19c7-444a-5f45-be31-2f1d5abae36a"
          },
          {
