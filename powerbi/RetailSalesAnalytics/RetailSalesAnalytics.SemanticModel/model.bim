          {
            "name": "Distinct Active Products",
            "expression": "COUNTROWS(FILTER(VALUES(Product[source_stock_item_id]),[Eligible Invoice Lines]>0))",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": "Distinct Active Products",
            "lineageTag": "0ddfd239-6e4a-5696-a1fc-705a43693202"
          },
          {
            "name": "Top 20% SKU Sales Share",
            "expression": "VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),\"@Sales\",[Product Sales],\"@Lines\",[Eligible Invoice Lines]),[@Lines]>0) VAR N=ROUNDUP(COUNTROWS(Population)*0.2,0) RETURN DIVIDE(SUMX(TOPN(N,Population,[@Sales],DESC,Product[source_stock_item_id],ASC),[@Sales]),SUMX(Population,[@Sales]))",
            "formatString": "0.00%",
            "displayFolder": "Products",
            "description": "Top 20% SKU Sales Share",
            "lineageTag": "33f1e7d6-a256-51d1-874b-37b38bbaaf1c"
          },
          {
            "name": "SKUs for 80% Sales",
            "expression": "VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),\"@Sales\",[Product Sales],\"@Lines\",[Eligible Invoice Lines]),[@Lines]>0)\nVAR TotalSales=SUMX(Population,[@Sales])\nRETURN IF(TotalSales>0,1+COUNTROWS(FILTER(Population,VAR S=[@Sales] VAR K=Product[source_stock_item_id]\nVAR Cumulative=SUMX(FILTER(Population,[@Sales]>S||([@Sales]=S&&Product[source_stock_item_id]<=K)),[@Sales]) RETURN Cumulative<TotalSales*0.8)))",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": "SKUs for 80% Sales",
            "lineageTag": "ccfba092-f68b-5037-a6db-26803f3fa6f2"
          },
          {
            "name": "Selected Top N",
            "expression": "SELECTEDVALUE('Top N'[Value],10)",
            "formatString": "#,0",
            "displayFolder": "Parameters",
            "description": "Selected Top N",
            "lineageTag": "26489fba-ac0e-55ca-91e8-c5114b868a19"
          },
          {
            "name": "Top N Ranking Overlap",
            "expression": "VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),\"@Sales\",[Product Sales],\"@Units\",[Product Units],\"@Lines\",[Eligible Invoice Lines]),[@Lines]>0) VAR N=[Selected Top N] VAR A=SELECTCOLUMNS(TOPN(N,Population,[@Sales],DESC,Product[source_stock_item_id],ASC),\"ID\",Product[source_stock_item_id]) VAR B=SELECTCOLUMNS(TOPN(N,Population,[@Units],DESC,Product[source_stock_item_id],ASC),\"ID\",Product[source_stock_item_id]) RETURN COUNTROWS(INTERSECT(A,B))",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": "Top N Ranking Overlap",
            "lineageTag": "2ff164c3-108d-5c7b-a668-60641e37eb90"
          },
