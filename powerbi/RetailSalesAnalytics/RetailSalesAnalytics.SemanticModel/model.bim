          {
            "name": "Buyer Cumulative Share %",
            "expression": "VAR N=MAX(1,COALESCE(MAX('Concentration Rank'[Value]),1)) VAR Population=ADDCOLUMNS(ALLSELECTED('Buyer'),\"@Sales\",[Buyer Sales]) VAR TopSales=SUMX(TOPN(N,Population,[@Sales],DESC,'Buyer'[source_customer_id],ASC),[@Sales]) RETURN DIVIDE(TopSales,SUMX(Population,[@Sales]))",
