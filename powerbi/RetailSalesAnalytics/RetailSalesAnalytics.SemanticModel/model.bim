          {
            "name": "Negative LineProfit Records",
            "expression": "CALCULATE([Eligible Invoice Lines],'Invoice Lines'[source_reported_line_profit]<0)",
            "formatString": "#,0",
            "displayFolder": "Exceptions",
            "description": "Negative LineProfit Records",
            "lineageTag": "d8c511a4-2a22-5a73-a626-b568f30e1333"
          },
          {
            "name": "Negative LineProfit Rate",
            "expression": "DIVIDE([Negative LineProfit Records],[Eligible Invoice Lines])",
            "formatString": "0.00%",
            "displayFolder": "Exceptions",
            "description": "Negative LineProfit Rate",
            "lineageTag": "65617814-20de-57aa-ab8b-3b2aa93126ee"
          },
          {
            "name": "Negative Source LineProfit",
            "expression": "CALCULATE(SUM('Invoice Lines'[source_reported_line_profit]),'Invoice Lines'[source_reported_line_profit]<0,'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0.00",
            "displayFolder": "Exceptions",
            "description": "Source-reported negative component, not certified losses, GP or COGS.",
            "lineageTag": "f3d2ec5f-6db9-5e1e-87a0-3ca896a55ab9"
          },
          {
            "name": "Affected Product Count",
            "expression": "CALCULATE(DISTINCTCOUNT('Invoice Lines'[source_stock_item_id]),'Invoice Lines'[source_reported_line_profit]<0,'Invoice Lines'[is_sales_eligible]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exceptions",
            "description": "Affected Product Count",
            "lineageTag": "918c8b83-0404-58df-a072-ae7f2cbea093"
          },
          {
            "name": "Data Coverage Days",
            "expression": "COUNTROWS(VALUES('Date'[calendar_date]))",
            "formatString": "#,0",
            "displayFolder": "Coverage",
            "description": "Data Coverage Days",
            "lineageTag": "712a9e9c-4226-5cce-a85f-6d55141d9ee4"
          },
          {
            "name": "Zero-Transaction Days",
            "expression": "COUNTROWS(FILTER(VALUES('Date'[calendar_date]),COALESCE([Invoice Count],0)=0&&COALESCE([Order Count],0)=0))",
            "formatString": "#,0",
            "displayFolder": "Coverage",
            "description": "Zero-Transaction Days",
            "lineageTag": "4359e625-94cb-549f-a409-d683ebce6d73"
          },
          {
            "name": "Active Sales Days",
            "expression": "COUNTROWS(FILTER(VALUES('Date'[calendar_date]),[Invoice Count]>0))",
            "formatString": "#,0",
            "displayFolder": "Coverage",
            "description": "Active Sales Days",
            "lineageTag": "2ce5294c-2887-5723-9d48-a2d8cf59825e"
          },
          {
            "name": "Zero-Transaction Sundays",
            "expression": "COUNTROWS(FILTER(VALUES('Date'[calendar_date]),WEEKDAY('Date'[calendar_date],2)=7&&COALESCE([Invoice Count],0)=0&&COALESCE([Order Count],0)=0))",
            "formatString": "#,0",
            "displayFolder": "Coverage",
            "description": "Zero-Transaction Sundays",
            "lineageTag": "52115f68-531a-5030-b9c6-caab6d7dd170"
          },
          {
            "name": "Orders with Direct Invoice",
            "expression": "VAR InvoicedOrders=CALCULATETABLE(VALUES(Invoices[source_order_id]),REMOVEFILTERS('Date'),Invoices[is_sales_eligible]=TRUE()) RETURN CALCULATE([Order Count],TREATAS(InvoicedOrders,Orders[source_order_id]))",
            "formatString": "#,0",
            "displayFolder": "Coverage",
            "description": "Selected OrderDate cohort; direct invoice references across captured dates, not a fulfillment status.",
            "lineageTag": "e26e1b58-a2f2-56fc-9ec2-55744c09613a"
          },
          {
            "name": "Orders without Direct Invoice",
            "expression": "[Order Count]-[Orders with Direct Invoice]",
            "formatString": "#,0",
            "displayFolder": "Coverage",
            "description": "Orders without Direct Invoice",
            "lineageTag": "825bbd85-9b58-57c5-be60-07f34a6d94b9"
          },
          {
            "name": "Backorder Diagnostic Status",
            "expression": "\"BLOCKED: BackorderOrderID is absent from the 12 approved BI objects. Direct-link gap is not a fulfillment failure rate.\"",
            "formatString": "",
            "displayFolder": "Narratives",
            "description": "Backorder Diagnostic Status",
            "lineageTag": "bc24a287-9d63-5ec3-a72d-6f18b5a8c246"
          },
          {
            "name": "Coverage Narrative",
            "expression": "\"Observed calendar and source-profit diagnostics only. Zero-transaction Sundays are not missing data; negative source LineProfit is not certified accounting loss.\"",
            "formatString": "",
            "displayFolder": "Narratives",
            "description": "Coverage Narrative",
            "lineageTag": "0b3002b7-9a95-51b2-bb5d-1651208b52a9"
          }
        ]
      }
