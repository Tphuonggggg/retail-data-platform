          {
            "name": "Product Rank by Sales",
            "expression": "VAR ThisId=SELECTEDVALUE(Product[source_stock_item_id]) VAR ThisValue=[Product Sales]\nVAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),\"@Value\",[Product Sales],\"@Lines\",[Eligible Invoice Lines]),[@Lines]>0)\nRETURN IF(HASONEVALUE(Product[source_stock_item_id])&&NOT ISBLANK(ThisValue),1+COUNTROWS(FILTER(Population,[@Value]>ThisValue||([@Value]=ThisValue&&Product[source_stock_item_id]<ThisId))))",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": "Selected product population; deterministic SKU ID tie-break.",
            "lineageTag": "bf41dec7-6155-5cef-ab10-cce37d5b52f9"
          },
          {
            "name": "Product Rank by Units",
            "expression": "VAR ThisId=SELECTEDVALUE(Product[source_stock_item_id]) VAR ThisValue=[Product Units]\nVAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),\"@Value\",[Product Units],\"@Lines\",[Eligible Invoice Lines]),[@Lines]>0)\nRETURN IF(HASONEVALUE(Product[source_stock_item_id])&&NOT ISBLANK(ThisValue),1+COUNTROWS(FILTER(Population,[@Value]>ThisValue||([@Value]=ThisValue&&Product[source_stock_item_id]<ThisId))))",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": "Selected product population; deterministic SKU ID tie-break.",
            "lineageTag": "c875758a-5c06-53bb-8aff-1846f31a5a12"
          },
          {
            "name": "Product Cumulative Sales",
            "expression": "VAR ThisId=SELECTEDVALUE(Product[source_stock_item_id]) VAR ThisSales=[Product Sales]\nVAR Population=ADDCOLUMNS(ALLSELECTED(Product),\"@Sales\",[Product Sales])\nRETURN IF(HASONEVALUE(Product[source_stock_item_id]),SUMX(FILTER(Population,[@Sales]>ThisSales||([@Sales]=ThisSales&&Product[source_stock_item_id]<=ThisId)),[@Sales]))",
            "formatString": "#,0.00",
            "displayFolder": "Products",
            "description": "Product Cumulative Sales",
            "lineageTag": "24a84c6f-1e52-5c36-9a0b-8ee0f1492a11"
          },
          {
            "name": "Product Cumulative Sales %",
            "expression": "DIVIDE([Product Cumulative Sales],CALCULATE([Product Sales],ALLSELECTED(Product)))",
