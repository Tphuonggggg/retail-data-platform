            "lineageTag": "fc8315bd-cb92-5ca8-b499-872cc4950df6"
          },
          {
            "name": "Comparable-Period Product Rank",
            "expression": "VAR Cutoff=CALCULATE(MAX('Date'[calendar_date]),REMOVEFILTERS('Date')) RETURN CALCULATE([Product Rank by Sales],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[calendar_date],DATE(YEAR(Cutoff),1,1),Cutoff))",
            "formatString": "#,0",
            "displayFolder": "Products",
            "description": "Comparable-Period Product Rank",
            "lineageTag": "a5f62a99-f91d-57b5-a30a-e45c46fd8d0e"
