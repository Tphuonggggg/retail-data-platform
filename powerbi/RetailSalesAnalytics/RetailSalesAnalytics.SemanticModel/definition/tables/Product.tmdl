				    Source = PostgreSQL.Database("127.0.0.1:55434", "retail_raw", [CreateNavigationProperties=false]),
				    Data = Source{[Schema="dw_core",Item="dim_product"]}[Data],
				    Selected = Table.SelectColumns(Data, {"product_key", "source_stock_item_id", "stock_item_name", "brand", "size", "_capture_id"}),
				    VersionIDs = List.Distinct(Selected[_capture_id]),
				    Pinned = if List.Count(VersionIDs) = 1 and Text.From(VersionIDs{0}) = "3a2f011d-f3b3-5683-83a2-a64837720f3d" then Selected else error "Unexpected analytical version",
				    Typed = Table.TransformColumnTypes(Pinned, {{"product_key", type text}, {"source_stock_item_id", Int64.Type}, {"stock_item_name", type text}, {"brand", type text}, {"size", type text}, {"_capture_id", type text}})
				in
