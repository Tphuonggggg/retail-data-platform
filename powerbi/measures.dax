// Sales | S05: invoiced sales before tax, InvoiceDate; not recognized revenue. Eligible WARNING rows retained.
Total Sales Before Tax =
CALCULATE(SUM('Invoice Lines'[invoiced_sales_before_tax]),'Invoice Lines'[is_sales_eligible]=TRUE())

// Sales | Total Tax
Total Tax =
CALCULATE(SUM('Invoice Lines'[tax_amount]),'Invoice Lines'[is_sales_eligible]=TRUE())

// Sales | Total Amount Including Tax
Total Amount Including Tax =
CALCULATE(SUM('Invoice Lines'[invoice_amount_including_tax]),'Invoice Lines'[is_sales_eligible]=TRUE())

// Sales | Units Sold
Units Sold =
CALCULATE(SUM('Invoice Lines'[quantity]),'Invoice Lines'[is_sales_eligible]=TRUE())

// Sales | Eligible Invoice Lines
Eligible Invoice Lines =
CALCULATE(COUNTROWS('Invoice Lines'),'Invoice Lines'[is_sales_eligible]=TRUE())

// Sales | S02: eligible invoice-header population. Product filtering uses invoice ID semijoin, never summed product distinct counts.
Invoice Count =
VAR BaseCount=CALCULATE(COUNTROWS(Invoices),Invoices[is_sales_eligible]=TRUE())
RETURN IF(ISCROSSFILTERED(Product),
 CALCULATE(COUNTROWS(Invoices),Invoices[is_sales_eligible]=TRUE(),
 TREATAS(CALCULATETABLE(VALUES('Invoice Lines'[source_invoice_id]),'Invoice Lines'[is_sales_eligible]=TRUE()),Invoices[source_invoice_id])),BaseCount)

// Sales | S01: Orders/OrderDate, including uninvoiced orders; intentionally not product-filtered.
Order Count =
CALCULATE(COUNTROWS(Orders),Orders[is_order_eligible]=TRUE())

// Sales | S06: recomputed ratio of totals in the same context; not AOV.
Average Invoice Value =
DIVIDE([Total Sales Before Tax],[Invoice Count])

// Sales | Source quantity basis; not standardized packaging or piece price.
Sales per Unit =
DIVIDE([Total Sales Before Tax],[Units Sold])

// Time intelligence | Only one selected calendar year. Same selected dates shifted 12 months; leap day maps to prior Feb 28. Other filters retained.
Sales Previous Year Comparable Period =
VAR PreviousDates=SELECTCOLUMNS(VALUES('Date'[calendar_date]),"PriorDate",EDATE('Date'[calendar_date],-12))
RETURN IF(HASONEVALUE('Date'[calendar_year]),CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),TREATAS(PreviousDates,'Date'[calendar_date])))

// Time intelligence | Sales YoY %
Sales YoY % =
DIVIDE([Total Sales Before Tax]-[Sales Previous Year Comparable Period],[Sales Previous Year Comparable Period])

// Time intelligence | Only one selected calendar year. Same selected dates shifted 12 months; leap day maps to prior Feb 28. Other filters retained.
Invoice Count Previous Year Comparable Period =
VAR PreviousDates=SELECTCOLUMNS(VALUES('Date'[calendar_date]),"PriorDate",EDATE('Date'[calendar_date],-12))
RETURN IF(HASONEVALUE('Date'[calendar_year]),CALCULATE([Invoice Count],REMOVEFILTERS('Date'),TREATAS(PreviousDates,'Date'[calendar_date])))

// Time intelligence | Invoice Count YoY %
Invoice Count YoY % =
DIVIDE([Invoice Count]-[Invoice Count Previous Year Comparable Period],[Invoice Count Previous Year Comparable Period])

// Time intelligence | Only one selected calendar year. Same selected dates shifted 12 months; leap day maps to prior Feb 28. Other filters retained.
AIV Previous Year Comparable Period =
VAR PreviousDates=SELECTCOLUMNS(VALUES('Date'[calendar_date]),"PriorDate",EDATE('Date'[calendar_date],-12))
RETURN IF(HASONEVALUE('Date'[calendar_year]),CALCULATE([Average Invoice Value],REMOVEFILTERS('Date'),TREATAS(PreviousDates,'Date'[calendar_date])))

// Time intelligence | AIV YoY %
AIV YoY % =
DIVIDE([Average Invoice Value]-[AIV Previous Year Comparable Period],[AIV Previous Year Comparable Period])

// Time intelligence | Previous month only in a single year-month context; BLANK at multi-month totals.
Sales Previous Period =
IF(HASONEVALUE('Date'[Year Month]),CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),DATEADD('Date'[calendar_date],-1,MONTH)))

// Time intelligence | Sales MoM %
Sales MoM % =
DIVIDE([Total Sales Before Tax]-[Sales Previous Period],[Sales Previous Period])

// Time intelligence | Sales YTD
Sales YTD =
VAR Cutoff=MAX('Date'[calendar_date]) RETURN CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[calendar_date],DATE(YEAR(Cutoff),1,1),Cutoff))

// Time intelligence | Prior Year Comparable YTD
Prior Year Comparable YTD =
VAR Cutoff=MAX('Date'[calendar_date]) VAR Prior=EDATE(Cutoff,-12) RETURN CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[calendar_date],DATE(YEAR(Prior),1,1),Prior))

// Time intelligence | YTD YoY %
YTD YoY % =
DIVIDE([Sales YTD]-[Prior Year Comparable YTD],[Prior Year Comparable YTD])

// Decomposition | Volume Contribution
Volume Contribution =
IF(NOT ISBLANK([Invoice Count Previous Year Comparable Period]),([Invoice Count]-[Invoice Count Previous Year Comparable Period])*[AIV Previous Year Comparable Period])

// Decomposition | AIV Contribution
AIV Contribution =
IF(NOT ISBLANK([Invoice Count Previous Year Comparable Period]),([Average Invoice Value]-[AIV Previous Year Comparable Period])*[Invoice Count Previous Year Comparable Period])

// Decomposition | Interaction Contribution
Interaction Contribution =
IF(NOT ISBLANK([Invoice Count Previous Year Comparable Period]),([Invoice Count]-[Invoice Count Previous Year Comparable Period])*([Average Invoice Value]-[AIV Previous Year Comparable Period]))

// Decomposition | Exact three-term delta: deltaN*A0 + N0*deltaA + deltaN*deltaA. Arithmetic, not causality.
Sales Change Contribution =
SWITCH(SELECTEDVALUE(Decomposition[Component]),"Invoice volume",[Volume Contribution],"AIV",[AIV Contribution],"Interaction",[Interaction Contribution])

// Narratives | Performance Narrative
Performance Narrative =
IF(ISBLANK([Sales YoY %]),"Select one calendar year. 2016 covers January–May only.","Sales "&FORMAT([Sales YoY %],"+0.00%;-0.00%")&" | invoices "&FORMAT([Invoice Count YoY %],"+0.00%;-0.00%")&" | AIV "&FORMAT([AIV YoY %],"+0.00%;-0.00%")&" versus equivalent prior-year dates.")

// Products | Product Sales
Product Sales =
[Total Sales Before Tax]

// Products | Product Units
Product Units =
[Units Sold]

// Products | Product Sales per Unit
Product Sales per Unit =
[Sales per Unit]

// Products | Product Sales Share %
Product Sales Share % =
DIVIDE([Product Sales],CALCULATE([Product Sales],ALLSELECTED(Product)))

// Products | Selected product population; deterministic SKU ID tie-break.
Product Rank by Sales =
VAR ThisId=SELECTEDVALUE(Product[source_stock_item_id]) VAR ThisValue=[Product Sales]
VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),"@Value",[Product Sales],"@Lines",[Eligible Invoice Lines]),[@Lines]>0)
RETURN IF(HASONEVALUE(Product[source_stock_item_id])&&NOT ISBLANK(ThisValue),1+COUNTROWS(FILTER(Population,[@Value]>ThisValue||([@Value]=ThisValue&&Product[source_stock_item_id]<ThisId))))

// Products | Selected product population; deterministic SKU ID tie-break.
Product Rank by Units =
VAR ThisId=SELECTEDVALUE(Product[source_stock_item_id]) VAR ThisValue=[Product Units]
VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),"@Value",[Product Units],"@Lines",[Eligible Invoice Lines]),[@Lines]>0)
RETURN IF(HASONEVALUE(Product[source_stock_item_id])&&NOT ISBLANK(ThisValue),1+COUNTROWS(FILTER(Population,[@Value]>ThisValue||([@Value]=ThisValue&&Product[source_stock_item_id]<ThisId))))

// Products | Product Cumulative Sales
Product Cumulative Sales =
VAR ThisId=SELECTEDVALUE(Product[source_stock_item_id]) VAR ThisSales=[Product Sales]
VAR Population=ADDCOLUMNS(ALLSELECTED(Product),"@Sales",[Product Sales])
RETURN IF(HASONEVALUE(Product[source_stock_item_id]),SUMX(FILTER(Population,[@Sales]>ThisSales||([@Sales]=ThisSales&&Product[source_stock_item_id]<=ThisId)),[@Sales]))

// Products | Product Cumulative Sales %
Product Cumulative Sales % =
DIVIDE([Product Cumulative Sales],CALCULATE([Product Sales],ALLSELECTED(Product)))

// Products | Pareto Threshold
Pareto Threshold =
0.8

// Products | Distinct Active Products
Distinct Active Products =
COUNTROWS(FILTER(VALUES(Product[source_stock_item_id]),[Eligible Invoice Lines]>0))

// Products | Top 20% SKU Sales Share
Top 20% SKU Sales Share =
VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),"@Sales",[Product Sales],"@Lines",[Eligible Invoice Lines]),[@Lines]>0) VAR N=ROUNDUP(COUNTROWS(Population)*0.2,0) RETURN DIVIDE(SUMX(TOPN(N,Population,[@Sales],DESC,Product[source_stock_item_id],ASC),[@Sales]),SUMX(Population,[@Sales]))

// Products | SKUs for 80% Sales
SKUs for 80% Sales =
VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),"@Sales",[Product Sales],"@Lines",[Eligible Invoice Lines]),[@Lines]>0)
VAR TotalSales=SUMX(Population,[@Sales])
RETURN IF(TotalSales>0,1+COUNTROWS(FILTER(Population,VAR S=[@Sales] VAR K=Product[source_stock_item_id]
VAR Cumulative=SUMX(FILTER(Population,[@Sales]>S||([@Sales]=S&&Product[source_stock_item_id]<=K)),[@Sales]) RETURN Cumulative<TotalSales*0.8)))

// Parameters | Selected Top N
Selected Top N =
SELECTEDVALUE('Top N'[Value],10)

// Products | Top N Ranking Overlap
Top N Ranking Overlap =
VAR Population=FILTER(ADDCOLUMNS(ALLSELECTED(Product),"@Sales",[Product Sales],"@Units",[Product Units],"@Lines",[Eligible Invoice Lines]),[@Lines]>0) VAR N=[Selected Top N] VAR A=SELECTCOLUMNS(TOPN(N,Population,[@Sales],DESC,Product[source_stock_item_id],ASC),"ID",Product[source_stock_item_id]) VAR B=SELECTCOLUMNS(TOPN(N,Population,[@Units],DESC,Product[source_stock_item_id],ASC),"ID",Product[source_stock_item_id]) RETURN COUNTROWS(INTERSECT(A,B))

// Products | Top N Product Sales
Top N Product Sales =
IF([Product Rank by Sales]<=[Selected Top N],[Product Sales])

// Products | Top N Product Units
Top N Product Units =
IF([Product Rank by Units]<=[Selected Top N],[Product Units])

// Products | Product Active Months
Product Active Months =
COUNTROWS(FILTER(VALUES('Date'[Year Month]),[Eligible Invoice Lines]>0))

// Products | Product Lifetime Rank
Product Lifetime Rank =
CALCULATE([Product Rank by Sales],REMOVEFILTERS('Date'))

// Products | Comparable-Period Product Rank
Comparable-Period Product Rank =
VAR Cutoff=CALCULATE(MAX('Date'[calendar_date]),REMOVEFILTERS('Date')) RETURN CALCULATE([Product Rank by Sales],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[calendar_date],DATE(YEAR(Cutoff),1,1),Cutoff))

// Products | Product Rank Change
Product Rank Change =
[Product Lifetime Rank]-[Comparable-Period Product Rank]

// Products | Product Rank by Selected Basis
Product Rank by Selected Basis =
IF(SELECTEDVALUE('Ranking Basis'[Basis],"Sales")="Units",[Product Rank by Units],[Product Rank by Sales])

// Attribution | Same invoice Sales attributed by invoice-time role; never add Buyer and Bill-to totals.
Buyer Sales =
CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Bill-to'))

// Attribution | Buyer Sales Share %
Buyer Sales Share % =
DIVIDE([Buyer Sales],CALCULATE([Buyer Sales],ALLSELECTED('Buyer')))

// Attribution | Buyer Customer Count
Buyer Customer Count =
COUNTROWS(FILTER(VALUES('Buyer'[source_customer_id]),[Buyer Sales]<>BLANK()))

// Attribution | Buyer Rank
Buyer Rank =
IF(HASONEVALUE('Buyer'[source_customer_id]),RANKX(ALLSELECTED('Buyer'),[Buyer Sales],,DESC,Dense))

// Attribution | Top N Buyer Concentration %
Top N Buyer Concentration % =
VAR Population=ADDCOLUMNS(ALLSELECTED('Buyer'),"@Sales",[Buyer Sales]) RETURN DIVIDE(SUMX(TOPN([Selected Top N],Population,[@Sales],DESC,'Buyer'[source_customer_id],ASC),[@Sales]),SUMX(Population,[@Sales]))

// Attribution | Top 5 Buyer Concentration %
Top 5 Buyer Concentration % =
VAR Population=ADDCOLUMNS(ALLSELECTED('Buyer'),"@Sales",[Buyer Sales]) RETURN DIVIDE(SUMX(TOPN(5,Population,[@Sales],DESC,'Buyer'[source_customer_id],ASC),[@Sales]),SUMX(Population,[@Sales]))

// Attribution | Top N Buyer Sales
Top N Buyer Sales =
IF([Buyer Rank]<=[Selected Top N],[Buyer Sales])

// Attribution | Same invoice Sales attributed by invoice-time role; never add Buyer and Bill-to totals.
Bill-to Sales =
CALCULATE([Total Sales Before Tax],REMOVEFILTERS('Buyer'))

// Attribution | Bill-to Sales Share %
Bill-to Sales Share % =
DIVIDE([Bill-to Sales],CALCULATE([Bill-to Sales],ALLSELECTED('Bill-to')))

// Attribution | Bill-to Customer Count
Bill-to Customer Count =
COUNTROWS(FILTER(VALUES('Bill-to'[source_customer_id]),[Bill-to Sales]<>BLANK()))

// Attribution | Bill-to Rank
Bill-to Rank =
IF(HASONEVALUE('Bill-to'[source_customer_id]),RANKX(ALLSELECTED('Bill-to'),[Bill-to Sales],,DESC,Dense))

// Attribution | Top N Bill-to Concentration %
Top N Bill-to Concentration % =
VAR Population=ADDCOLUMNS(ALLSELECTED('Bill-to'),"@Sales",[Bill-to Sales]) RETURN DIVIDE(SUMX(TOPN([Selected Top N],Population,[@Sales],DESC,'Bill-to'[source_customer_id],ASC),[@Sales]),SUMX(Population,[@Sales]))

// Attribution | Top 5 Bill-to Concentration %
Top 5 Bill-to Concentration % =
VAR Population=ADDCOLUMNS(ALLSELECTED('Bill-to'),"@Sales",[Bill-to Sales]) RETURN DIVIDE(SUMX(TOPN(5,Population,[@Sales],DESC,'Bill-to'[source_customer_id],ASC),[@Sales]),SUMX(Population,[@Sales]))

// Attribution | Top N Bill-to Sales
Top N Bill-to Sales =
IF([Bill-to Rank]<=[Selected Top N],[Bill-to Sales])

// Attribution | Selected Role Sales
Selected Role Sales =
IF(SELECTEDVALUE(Role[Role],"Buyer")="Buyer",CALCULATE([Buyer Sales],TREATAS(VALUES('Attribution Customer'[source_customer_id]),Buyer[source_customer_id])),CALCULATE([Bill-to Sales],TREATAS(VALUES('Attribution Customer'[source_customer_id]),'Bill-to'[source_customer_id])))

// Attribution | Selected Role Sales Share %
Selected Role Sales Share % =
DIVIDE([Selected Role Sales],CALCULATE([Selected Role Sales],ALLSELECTED('Attribution Customer')))

// Attribution | Selected Role Rank
Selected Role Rank =
IF(HASONEVALUE('Attribution Customer'[source_customer_id]),RANKX(ALLSELECTED('Attribution Customer'),[Selected Role Sales],,DESC,Dense))

// Attribution | Buyer Cumulative Share %
Buyer Cumulative Share % =
VAR N=MAX(1,COALESCE(MAX('Concentration Rank'[Value]),1)) VAR Population=ADDCOLUMNS(ALLSELECTED('Buyer'),"@Sales",[Buyer Sales]) VAR TopSales=SUMX(TOPN(N,Population,[@Sales],DESC,'Buyer'[source_customer_id],ASC),[@Sales]) RETURN DIVIDE(TopSales,SUMX(Population,[@Sales]))

// Attribution | Bill-to Cumulative Share %
Bill-to Cumulative Share % =
VAR N=MAX(1,COALESCE(MAX('Concentration Rank'[Value]),1)) VAR Population=ADDCOLUMNS(ALLSELECTED('Bill-to'),"@Sales",[Bill-to Sales]) VAR TopSales=SUMX(TOPN(N,Population,[@Sales],DESC,'Bill-to'[source_customer_id],ASC),[@Sales]) RETURN DIVIDE(TopSales,SUMX(Population,[@Sales]))

// Exceptions | Negative LineProfit Records
Negative LineProfit Records =
CALCULATE([Eligible Invoice Lines],'Invoice Lines'[source_reported_line_profit]<0)

// Exceptions | Negative LineProfit Rate
Negative LineProfit Rate =
DIVIDE([Negative LineProfit Records],[Eligible Invoice Lines])

// Exceptions | Source-reported negative component, not certified losses, GP or COGS.
Negative Source LineProfit =
CALCULATE(SUM('Invoice Lines'[source_reported_line_profit]),'Invoice Lines'[source_reported_line_profit]<0,'Invoice Lines'[is_sales_eligible]=TRUE())

// Exceptions | Affected Product Count
Affected Product Count =
CALCULATE(DISTINCTCOUNT('Invoice Lines'[source_stock_item_id]),'Invoice Lines'[source_reported_line_profit]<0,'Invoice Lines'[is_sales_eligible]=TRUE())

// Coverage | Data Coverage Days
Data Coverage Days =
COUNTROWS(VALUES('Date'[calendar_date]))

// Coverage | Zero-Transaction Days
Zero-Transaction Days =
COUNTROWS(FILTER(VALUES('Date'[calendar_date]),COALESCE([Invoice Count],0)=0&&COALESCE([Order Count],0)=0))

// Coverage | Active Sales Days
Active Sales Days =
COUNTROWS(FILTER(VALUES('Date'[calendar_date]),[Invoice Count]>0))

// Coverage | Zero-Transaction Sundays
Zero-Transaction Sundays =
COUNTROWS(FILTER(VALUES('Date'[calendar_date]),WEEKDAY('Date'[calendar_date],2)=7&&COALESCE([Invoice Count],0)=0&&COALESCE([Order Count],0)=0))

// Coverage | Selected OrderDate cohort; direct invoice references across captured dates, not a fulfillment status.
Orders with Direct Invoice =
VAR InvoicedOrders=CALCULATETABLE(VALUES(Invoices[source_order_id]),REMOVEFILTERS('Date'),Invoices[is_sales_eligible]=TRUE()) RETURN CALCULATE([Order Count],TREATAS(InvoicedOrders,Orders[source_order_id]))

// Coverage | Orders without Direct Invoice
Orders without Direct Invoice =
[Order Count]-[Orders with Direct Invoice]

// Narratives | Backorder Diagnostic Status
Backorder Diagnostic Status =
"BLOCKED: BackorderOrderID is absent from the 12 approved BI objects. Direct-link gap is not a fulfillment failure rate."

// Narratives | Coverage Narrative
Coverage Narrative =
"Observed calendar and source-profit diagnostics only. Zero-transaction Sundays are not missing data; negative source LineProfit is not certified accounting loss."
